digraph example_four_b {

    ranksep=0.3;
    nodesep=0.10;
    rankdir=LR;
    mclimit=10;
    minlen=2;
    dpi=300;
    pad=0.1;
    margin=0.1;
    node [width=0.47, height=0.47, fixedsize=true, fontname="sans-serif",fontsize=10];
    edge [arrowsize=0.7,arrowhead=vee];
	"&lt;a,b,c&gt;" [label="&lt;a,b,c&gt;" colorscheme=set28 fillcolor=2 penwidth=1 shape=doublecircle style=filled xlabel=s4]
