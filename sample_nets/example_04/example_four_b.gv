	"&lt;a&gt;" [label="&lt;a&gt;" shape=circle xlabel=s1]
	"&epsilon;" [label="&epsilon;" colorscheme=set28 fillcolor=1 shape=circle style=filled xlabel=s0]
	start [label="" height=0.1 shape=point width=0.1 xlabel=start]
	start -> "&epsilon;"
	"&lt;a,b&gt;_&chi;" [label="&chi; | 0.5" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a,b&gt;" -> "&lt;a,b&gt;_&chi;" [dir=none]
	"&lt;a,b&gt;_&chi;" -> "&epsilon;"
	"&lt;a,b&gt;_c" [label="c | 0.5" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a,b&gt;" -> "&lt;a,b&gt;_c" [dir=none]
	"&lt;a,b&gt;_c" -> "&lt;a,b,c&gt;"
	"&lt;a,c&gt;_b" [label="b | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a,c&gt;" -> "&lt;a,c&gt;_b" [dir=none]
	"&lt;a,c&gt;_b" -> "&lt;a,c,b&gt;"
	"&lt;a,b,c&gt;_&chi;" [label="&chi; | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a,b,c&gt;" -> "&lt;a,b,c&gt;_&chi;" [dir=none]
	"&lt;a,b,c&gt;_&chi;" -> "&epsilon;"
	"&lt;a&gt;_c" [label="c | 0.368" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a&gt;" -> "&lt;a&gt;_c" [dir=none]
	"&lt;a&gt;_c" -> "&lt;a,c&gt;"
	"&lt;a&gt;_b" [label="b | 0.632" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a&gt;" -> "&lt;a&gt;_b" [dir=none]
	"&lt;a&gt;_b" -> "&lt;a,b&gt;"
	"&lt;a,c,b&gt;_&chi;" [label="&chi; | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a,c,b&gt;" -> "&lt;a,c,b&gt;_&chi;" [dir=none]
