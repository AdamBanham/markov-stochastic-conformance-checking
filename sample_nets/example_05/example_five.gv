	"(L&amp;R)&lt;a,b,c&gt;" -> "(L&amp;R)&lt;a,b,c&gt;_&chi;" [dir=none]
	"(L&amp;R)&lt;a,b,c&gt;_&chi;" -> "(L&amp;R)&epsilon;"
	"(L&amp;R)&lt;a,b&gt;_&chi;" [label="&chi; | 0.5" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=14 height=0.46666666666666673 shape=plaintext style="rounded,dashed" width=0.7000000000000001]
	"(L&amp;R)&lt;a,b&gt;" -> "(L&amp;R)&lt;a,b&gt;_&chi;" [dir=none]
	"(L&amp;R)&lt;a,b&gt;_&chi;" -> "(L&amp;R)&epsilon;"
	"(L&amp;R)&lt;a,b&gt;_c" [label="c | 0.5" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=14 height=0.46666666666666673 shape=plaintext style="rounded,dashed" width=0.7000000000000001]
	"(L&amp;R)&lt;a,b&gt;" -> "(L&amp;R)&lt;a,b&gt;_c" [dir=none]
