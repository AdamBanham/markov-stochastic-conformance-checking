digraph motivated_example_02_right {

    ranksep=0.5;
    nodesep=0.4;
    rankdir=LR;
    mclimit=100;
    minlen=5;
    dpi=300;
    pad=0.1;
    margin=0.1;
    node [width=0.47, height=0.47, fixedsize=true, fontname="sans-serif",fontsize=10];
    edge [arrowsize=0.7,arrowhead=vee];
    
	start [label="" height=0.1 shape=point width=0.1 xlabel=start]
	"&epsilon;" [label="&epsilon;" colorscheme=set28 fillcolor=1 shape=circle style=filled xlabel=s0]
    {
        rank=same
        "2''" [label="2''" shape=circle xlabel=s1]
        "7''" [label="7''" colorscheme=set28 fillcolor=2 penwidth=1 shape=doublecircle style=filled xlabel=s6]
    }
    
    {
        rank=same
        "3''" [label="3''" shape=circle xlabel=s2]
        
        "6''" [label="6''" shape=circle xlabel=s5]
        "4''" [label="4''" colorscheme=set28 fillcolor=2 penwidth=1 shape=doublecircle style=filled xlabel=s3]
        "4''" -> "6''" [style=invis]
	    "3''_c" [label="c | 0.5" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
    }
        
    
    {
        rank=same
    	"6''_c" [label="c | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	    "2''_v" [label="v | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
    	
        
    }
    
    {
        rank=same
        "5''" [label="5''" shape=circle xlabel=s4]
    	"5''_v" [label="v | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
    } 
    
	"3''_f" [label="f | 0.5" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	
	start -> "&epsilon;"
	"&epsilon;" -> "&epsilon;_a" [dir=none]
	"&epsilon;_a" -> "2''"

	"5''" -> "5''_v" [dir=none]
	"5''_v" -> "6''"
	"2''" -> "2''_v" [dir=none]
	"2''_v" -> "3''"
	
	"3''" -> "3''_f" [dir=none]
	"3''_f" -> "5''"

	"3''" -> "3''_c" [dir=none]
	"3''_c" -> "4''"

	"7''" -> "7''_&chi;" [dir=none]
	"7''_&chi;" -> "&epsilon;"

	"6''" -> "6''_c" [dir=none]
	"6''_c" -> "7''"

	"4''" -> "4''_&chi;" [dir=none]
	"4''_&chi;" -> "&epsilon;"

	{
	    rank=same
    	"4''_&chi;" [label="&chi; | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	    "&epsilon;_a" [label="a | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
		"7''_&chi;" [label="&chi; | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
		"4''_&chi;" -> "7''_&chi;"  [style=invis]
    
	}

}
