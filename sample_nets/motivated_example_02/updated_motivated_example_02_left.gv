digraph motivated_example_02_left {

    ranksep=0.2;
    nodesep=0.3;
    rankdir=LR;
    mclimit=10000;
    minlen=4;
    dpi=300;
    pad=0.1;
    margin=0.1;
    node [width=0.47, height=0.47, fixedsize=true, fontname="sans-serif",fontsize=10];
    edge [arrowsize=0.7,arrowhead=vee];
    
	start [label="" height=0.1 shape=point width=0.1 xlabel=start]
	"&lt;c&gt;" [label="&lt;c&gt;" colorscheme=set28 fillcolor=2 penwidth=1 shape=doublecircle style=filled xlabel=s3]
	"&lt;a&gt;" [label="&lt;a&gt;" shape=circle xlabel=s1]
	"&epsilon;" [label="&epsilon;" colorscheme=set28 fillcolor=1 shape=circle style=filled xlabel=s0]
	"&lt;v&gt;" [label="&lt;v&gt;" shape=circle xlabel=s2]
	
	start -> "&epsilon;"
	"&lt;a&gt;_v" [label="v | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;a&gt;" -> "&lt;a&gt;_v" [dir=none]
	"&lt;a&gt;_v" -> "&lt;v&gt;"
	"&epsilon;_a" [label="a | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&epsilon;" -> "&epsilon;_a" [dir=none]
	"&epsilon;_a" -> "&lt;a&gt;"
	"&lt;v&gt;_c" [label="c | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;v&gt;" -> "&lt;v&gt;_c" [dir=none]
	"&lt;v&gt;_c" -> "&lt;c&gt;"
	"&lt;c&gt;_&chi;" [label="&chi; | 1.0" colorscheme=set28 fillcolor=7 fontcolor=1 fontname="Times-Roman" fontsize=12 height=0.4 shape=plaintext style="rounded,dashed" width=0.6]
	"&lt;c&gt;" -> "&lt;c&gt;_&chi;" [dir=none]
	"&lt;c&gt;_&chi;" -> "&epsilon;"
}
